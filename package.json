{
  "name": "go-for-go-book",
  "scripts": {
    "start": "npm-run-all -p serve watch:build",
    "serve": "browser-sync start --server --files='build/*.html' --index=build/index.html --serveStatic=build --no-open --no-ui --reload-delay=500 --port=9999",
    "lint": "bundle exec ./scripts/textlint-asciidoctor -r ./macro.rb -T code,dfn index.adoc",
    "test": "npm run lint",
    "watch:build": "gaze 'npm run build:html' *.adoc **/*.adoc examples/**/*.go macro.rb",
    "build:html": "bundle exec asciidoctor -r ./macro.rb index.adoc -D build",
    "build:wip": "bundle exec asciidoctor -r ./macro.rb -a wip index.adoc -D build",
    "build:pdf": "bundle exec asciidoctor-pdf -r ./macro.rb index.adoc -D build",
    "build:epub": "bundle exec asciidoctor-epub3 -r ./macro.rb index.adoc -D build",
    "listings": "./scripts/gen-listings.sh"
  },
  "author": "motemen (https://motemen.github.io/)",
  "private": true,
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "gaze-cli": "^0.2.0",
    "npm-run-all2": "^9.0.3",
    "textlint": "^15.8.0",
    "textlint-rule-no-doubled-conjunction": "^3.0.1",
    "textlint-rule-no-doubled-conjunctive-particle-ga": "^3.0.0",
    "textlint-rule-preset-japanese": "^10.0.4",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "textlint-rule-web-plus-db": "^1.1.5"
  }
}
